{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowFoundry Desktop",
  "version": "0.1.0",
  "identifier": "com.flowfoundry.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "FlowFoundry Desktop", "width": 1180, "height": 760, "minWidth": 800, "minHeight": 600 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true }
}
