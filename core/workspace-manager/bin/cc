#!/bin/bash
# cc — unified launcher (Claude / DeepSeek / Codex)
# Thin wrapper — delegates to the flowfoundry.cc Python module.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
MONOREPO_ROOT="$(cd "$SCRIPT_DIR/../../.." 2>/dev/null && pwd || true)"

# Source-checkout mode: make the monorepo package importable without requiring
# an editable install.  A deployed wrapper has no matching src/flowfoundry
# directory and therefore uses the installed package normally.
if [[ -d "$MONOREPO_ROOT/src/flowfoundry" ]]; then
    export PYTHONPATH="$MONOREPO_ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
fi

exec python3 -m flowfoundry.cc "$@"
