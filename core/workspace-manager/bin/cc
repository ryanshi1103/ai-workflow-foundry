#!/bin/bash
# cc — unified launcher (Claude / DeepSeek / Codex)
# Thin wrapper — delegates to flowfoundry.cc Python module.
# Fall back to legacy deployed copy if the repo package isn't importable.
set -euo pipefail

# Try the repo package first (monorepo dev mode)
if python3 -c "import flowfoundry.workspace.cc_launcher" 2>/dev/null; then
    exec python3 -m flowfoundry.cc "$@"
fi

# Fall back to legacy deployed copy
exec python3 -m flowfoundry.cc "$@"
