[Unit]
Description=cc-projects weekly quick maintenance
Wants=network-online.target
After=default.target network-online.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/cc-projects-maintain --quick
Nice=19
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cc-projects-quick

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/Projects %h/.local/state/cc-projects %h/.config/cc-projects %h/.local/state/cc-launcher
ReadOnlyPaths=%h/.local/bin %h/.local/share
