[Unit]
Description=cc-projects monthly deep maintenance
After=default.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/cc-projects-maintain --deep
Nice=19
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cc-projects-deep

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/Projects %h/.local/state/cc-projects %h/.config/cc-projects %h/.local/state/cc-launcher
ReadOnlyPaths=%h/.local/bin %h/.local/share
