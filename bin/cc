#!/bin/bash
# Claude / DeepSeek / Codex Unified Launcher — project-agnostic
# Supports Anthropic Claude, DeepSeek V4 Pro, and OpenAI Codex GPT-5.6 Sol.
# Works with any project; no hard-coded default project bias.
#
# Version: 3.1 — Added SSH/mobile remote-session safety
# CC_ACTIVE_PROJECT is the single source of truth for the project directory.

set -euo pipefail

# ─── Recent projects tracking ──────────────────────────────────────────────
RECENT_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/cc-launcher"
RECENT_FILE="${RECENT_STATE_DIR}/recent-projects"

# Timestamp pattern: YYYYMMDD-HHMMSS-tool-shortid
TIMESTAMP_PATTERN='^[0-9]{8}-[0-9]{6}-[a-z]+-[a-f0-9]{6}$'

is_timestamp_session_dir() {
    local name="$1"
    [[ "$name" =~ $TIMESTAMP_PATTERN ]]
}

add_to_recent() {
    local target_dir="$1"
    [[ -d "$target_dir" ]] || return 0

    # Reject timestamp session directories — they are not real projects
    local dir_name
    dir_name="$(basename "$target_dir")"
    if is_timestamp_session_dir "$dir_name"; then
        return 0
    fi

    # Reject session directories inside projects
    if [[ "$target_dir" == *"/.ai/sessions/"* ]] || [[ "$target_dir" == *"/.ai-session/sessions/"* ]]; then
        return 0
    fi

    # Ensure target is in ~/Projects (only track real project dirs)
    local projects_root="${HOME}/Projects"
    [[ "$target_dir" == "$projects_root"/* ]] || return 0

    mkdir -p "$RECENT_STATE_DIR" 2>/dev/null || return 0

    # Read existing, remove duplicates and non-existent dirs, keep order
    local cleaned=()
    local line
    if [[ -f "$RECENT_FILE" ]]; then
        while IFS= read -r line; do
            [[ -n "$line" ]] || continue
            [[ "$line" == "$target_dir" ]] && continue
            [[ -d "$line" ]] || continue
            # Also filter out timestamp dirs in existing file
            local existing_name
            existing_name="$(basename "$line")"
            if is_timestamp_session_dir "$existing_name"; then
                continue
            fi
            if [[ "$line" == *"/.ai/sessions/"* ]] || [[ "$line" == *"/.ai-session/sessions/"* ]]; then
                continue
            fi
            cleaned+=("$line")
        done < "$RECENT_FILE"
    fi

    # Write: new entry first, then existing (max 20 total)
    printf '%s\n' "$target_dir" > "${RECENT_FILE}.tmp"
    local count=1
    for line in "${cleaned[@]}"; do
        printf '%s\n' "$line" >> "${RECENT_FILE}.tmp"
        ((count++))
        [[ $count -ge 20 ]] && break
    done
    mv "${RECENT_FILE}.tmp" "$RECENT_FILE"
}

# ─── Global variable for selected project ──────────────────────────────────
PROJECT_DIR=""
CC_PROJECT_MODE="existing"  # current, existing, new, manual

# SSH and Tailscale SSH both export one or both of these variables.  The
# launcher keeps every mode available remotely, but high-risk modes require a
# second, remote-specific acknowledgement.
CC_REMOTE_SESSION=false
if [[ -n "${SSH_CONNECTION:-}" ]] || [[ -n "${SSH_TTY:-}" ]]; then
    CC_REMOTE_SESSION=true
fi

show_remote_session_banner() {
    [[ "$CC_REMOTE_SESSION" == true ]] || return 0
    echo ""
    echo "╔══════════════════════════════════════════════════════════╗"
    echo "║  📱 SSH 远程会话                                        ║"
    echo "╠══════════════════════════════════════════════════════════╣"
    echo "║  当前操作来自远程终端；全部启动器选项保持可用。         ║"
    echo "║  完全访问模式需要额外输入 remote-yes。                  ║"
    echo "╚══════════════════════════════════════════════════════════╝"
}

confirm_remote_high_risk() {
    local mode_name="$1"
    local remote_confirm=""
    [[ "$CC_REMOTE_SESSION" == true ]] || return 0

    echo ""
    echo "远程高权限确认: ${mode_name}"
    if ! read -r -p "请输入 'remote-yes' 继续: " remote_confirm; then
        echo "输入已关闭，已取消。"
        return 1
    fi
    if [[ "$remote_confirm" != "remote-yes" ]]; then
        echo "远程高权限确认失败，已取消。"
        return 1
    fi
}

# ─── Codex preflight check ──────────────────────────────────────────────────
CODEX_PREFLIGHT_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/cc-launcher"
CODEX_PREFLIGHT_FILE="${CODEX_PREFLIGHT_DIR}/codex-preflight"

codex_api_reachable() {
    # An HTTP response from the OpenAI API proves that DNS, TCP, and TLS all
    # work.  Do not use curl -f here: an unauthenticated 4xx response is still
    # a successful reachability check and this function must never read auth.
    if command -v curl >/dev/null 2>&1; then
        curl --silent --show-error --output /dev/null \
            --connect-timeout 5 --max-time 8 \
            https://api.openai.com/
        return $?
    fi

    # Minimal fallback for systems without curl.  This still checks DNS and
    # TCP reachability to the service actually used by Codex.
    timeout 5 bash -c 'exec 3<>/dev/tcp/api.openai.com/443' 2>/dev/null
}

codex_preflight_check() {
    local profile_name="$1"
    local profile_file="$HOME/.codex/${profile_name}.config.toml"

    # 1. Binary check (always run)
    local codex_bin
    codex_bin="$(type -P codex 2>/dev/null)" || {
        echo ""
        echo "错误: Codex CLI 未安装或不在 PATH 中。" >&2
        echo "请运行: npm install -g @openai/codex" >&2
        return 1
    }

    # 2. Version check (always run)
    local codex_version
    codex_version="$("$codex_bin" --version 2>/dev/null)" || {
        echo ""
        echo "错误: 无法获取 Codex 版本。" >&2
        return 1
    }
    # Parse version number: strip "codex-cli " prefix
    local version_num="${codex_version#codex-cli }"
    # Compare: need >= 0.144.0
    local major minor patch
    IFS='.' read -r major minor patch <<< "$version_num"
    if [[ -z "$major" ]] || (( major < 0 )) || (( major == 0 && minor < 144 )); then
        echo ""
        echo "错误: Codex 版本过低。当前: ${codex_version}，需要: >= 0.144.0" >&2
        echo "请运行: npm install -g @openai/codex" >&2
        return 1
    fi

    # 3. Project directory check (always run)
    if [[ ! -d "$PROJECT_DIR" ]]; then
        echo ""
        echo "错误: 项目目录不存在: $PROJECT_DIR" >&2
        return 1
    fi

    # 4. Profile file check (always run)
    if [[ ! -f "$profile_file" ]]; then
        echo ""
        echo "错误: Codex profile 文件不存在: $profile_file" >&2
        return 1
    fi

    # 5. Basic TOML validity check
    if ! grep -q 'model.*gpt-5.6-sol' "$profile_file" 2>/dev/null; then
        echo ""
        echo "错误: profile 文件缺少 model = \"gpt-5.6-sol\": $profile_file" >&2
        return 1
    fi

    # 6. OpenAI API reachability check (cached: max once per 24h)
    mkdir -p "$CODEX_PREFLIGHT_DIR" 2>/dev/null
    local now
    now="$(date +%s)"
    local last_check=0
    if [[ -f "$CODEX_PREFLIGHT_FILE" ]]; then
        IFS= read -r last_check < "$CODEX_PREFLIGHT_FILE" || last_check=0
        # Arithmetic expansion treats bare words as variable names.  Reject a
        # corrupt/legacy cache value (including the former literal "EOF")
        # before using it under `set -u`.
        if [[ ! "$last_check" =~ ^[0-9]+$ ]]; then
            last_check=0
        fi
    fi
    local check_age=$(( now - last_check ))
    if (( check_age > 86400 )) || [[ ! -f "$CODEX_PREFLIGHT_FILE" ]]; then
        if ! codex_api_reachable; then
            # Reachability problems do not block launch because Codex may
            # still recover after a transient network or VPN change.
            echo ""
            echo "警告: 无法连接 OpenAI API；请检查 DNS、VPN 或网络出口。" >&2
        fi
        # Update preflight file
        printf '%s\n' \
            "$now" \
            "$codex_bin" \
            "$codex_version" \
            "$profile_name" > "$CODEX_PREFLIGHT_FILE"
    fi

    return 0
}

# ─── Helper: project status indicators ─────────────────────────────────────
has_git() {
    git -C "$1" rev-parse --show-toplevel &>/dev/null 2>&1
}

has_ai_state() {
    [[ -f "$1/.ai-session/project.json" ]] || [[ -f "$1/.ai/project.json" ]]
}

project_indicators() {
    local d="$1"
    local indicators=""
    if has_git "$d"; then
        indicators="${indicators}[Git] "
    else
        indicators="${indicators}[非Git] "
    fi
    if has_ai_state "$d"; then
        indicators="${indicators}[AI]"
    fi
    echo "$indicators"
}

# Project view policy. Publishing mirrors and legacy review workspaces stay
# available without crowding the primary project picker.
MANAGED_PROJECTS_FILE="${CC_MANAGED_PROJECTS_FILE:-$HOME/.config/cc-projects/managed-projects}"

project_picker_group() {
    local project_name="$1"
    local configured_name configured_group _rest

    if [[ -f "$MANAGED_PROJECTS_FILE" ]]; then
        while IFS='|' read -r configured_name configured_group _rest; do
            configured_name="${configured_name#"${configured_name%%[![:space:]]*}"}"
            configured_name="${configured_name%"${configured_name##*[![:space:]]}"}"
            [[ -n "$configured_name" && "$configured_name" != \#* ]] || continue
            configured_group="${configured_group#"${configured_group%%[![:space:]]*}"}"
            configured_group="${configured_group%"${configured_group##*[![:space:]]}"}"
            if [[ "$configured_name" == "$project_name" ]]; then
                case "$configured_group" in
                    managed|archive) echo "managed" ;;
                    *) echo "primary" ;;
                esac
                return 0
            fi
        done < "$MANAGED_PROJECTS_FILE"
    fi

    echo "primary"
}

# ─── Helper: browse ~/Projects subdirectories ──────────────────────────────
browse_projects_dir() {
    local projects_dir="$HOME/Projects"
    local requested_group="${1:-primary}"

    if [[ ! -d "$projects_dir" ]]; then
        echo ""
        echo "错误: ~/Projects 目录不存在。" >&2
        return 1
    fi

    # Collect subdirectories: git repos first, then others, filter timestamp session dirs
    local git_dirs=()
    local normal_dirs=()
    local d name picker_group
    local managed_count=0

    for d in "$projects_dir"/*/; do
        [[ -d "$d" ]] || continue
        name="$(basename "$d")"
        # Infrastructure/quarantine directories are never launchable projects.
        if [[ "$name" == _* || "$name" == .* ]]; then
            continue
        fi
        # Skip timestamp session directories
        if is_timestamp_session_dir "$name"; then
            continue
        fi
        # Skip recovery directory
        if [[ "$name" == "_recovery-review" ]]; then
            continue
        fi
        picker_group="$(project_picker_group "$name")"
        if [[ "$picker_group" == "managed" ]]; then
            managed_count=$((managed_count + 1))
        fi
        if [[ "$picker_group" != "$requested_group" ]]; then
            continue
        fi
        if has_git "$d"; then
            git_dirs+=("$d")
        else
            normal_dirs+=("$d")
        fi
    done

    local all_dirs=("${git_dirs[@]}" "${normal_dirs[@]}")

    if [[ ${#all_dirs[@]} -eq 0 ]]; then
        echo ""
        echo "~/Projects 中没有找到任何项目目录。" >&2
        return 1
    fi

    echo ""
    if [[ "$requested_group" == "managed" ]]; then
        echo "托管发布与归档目录 (Git 仓库优先):"
    else
        echo "~/Projects 中的主项目 (Git 仓库优先):"
    fi
    echo ""
    local i=1
    for d in "${all_dirs[@]}"; do
        local d_clean="${d%/}"
        name="$(basename "$d_clean")"
        local indicators
        indicators="$(project_indicators "$d_clean")"
        printf "  %2d  %s  %s\n" "$i" "$name" "$indicators"
        printf "      %s\n" "$d_clean"
        ((i++))
    done
    if [[ "$requested_group" == "primary" && "$managed_count" -gt 0 ]]; then
        echo "   m  托管发布/归档目录 (${managed_count})"
    fi
    echo "   b  返回上一级"
    echo ""

    read -r -p "请选择编号: " NUM

    if [[ "$NUM" == "b" || "$NUM" == "B" ]]; then
        return 1
    fi

    if [[ "$requested_group" == "primary" && ( "$NUM" == "m" || "$NUM" == "M" ) ]]; then
        browse_projects_dir "managed"
        return $?
    fi

    if [[ "$NUM" =~ ^[0-9]+$ ]] && (( NUM >= 1 && NUM <= ${#all_dirs[@]} )); then
        PROJECT_DIR="${all_dirs[$((NUM-1))]}"
        PROJECT_DIR="${PROJECT_DIR%/}"
        CC_PROJECT_MODE="existing"
        return 0
    fi

    echo "无效选择。" >&2
    return 1
}

# ─── Helper: non-git project handling ─────────────────────────────────────
handle_non_git_project() {
    local target_dir="$1"
    echo ""
    echo "该目录不是 Git 仓库:"
    echo "  $target_dir"
    echo ""
    echo "  1  初始化 Git 后打开"
    echo "  2  直接打开，不初始化 Git"
    echo "  b  返回"
    echo "  q  退出"
    echo ""
    read -r -p "请选择 (1/2/b/q): " GIT_CHOICE

    case "$GIT_CHOICE" in
        1)
            if git -C "$target_dir" init &>/dev/null; then
                echo "Git 仓库已初始化。"
            else
                echo "警告: git init 失败，将直接打开。" >&2
            fi
            return 0
            ;;
        2)
            return 0
            ;;
        b|B)
            return 1
            ;;
        q|Q)
            echo "已取消。"
            exit 0
            ;;
        *)
            echo "无效选择。" >&2
            return 1
            ;;
    esac
}

# ─── Helper: manual path input ─────────────────────────────────────────────
manual_project_input() {
    echo ""
    read -r -p "请输入项目路径 (~ 会自动展开): " RAW_PATH

    # Expand ~ to $HOME
    RAW_PATH="${RAW_PATH/#\~/$HOME}"

    # Resolve to absolute path
    local resolved
    if [[ -d "$RAW_PATH" ]]; then
        resolved="$(cd "$RAW_PATH" && pwd)"
    else
        echo "错误: 目录不存在: $RAW_PATH" >&2
        return 1
    fi

    if [[ -f "$resolved" ]]; then
        echo "错误: 路径是普通文件，不是目录: $resolved" >&2
        return 1
    fi

    echo "解析后的路径: $resolved"
    PROJECT_DIR="$resolved"
    CC_PROJECT_MODE="manual"
    return 0
}

# ─── Helper: recent projects menu ─────────────────────────────────────────
recent_projects_menu() {
    mkdir -p "$RECENT_STATE_DIR" 2>/dev/null

    if [[ ! -f "$RECENT_FILE" ]] || [[ ! -s "$RECENT_FILE" ]]; then
        echo ""
        echo "暂无最近项目。"
        return 1
    fi

    # Read valid entries and clean up non-existent dirs and timestamp dirs
    local entries=()
    local line
    while IFS= read -r line; do
        [[ -d "$line" ]] || continue
        local name
        name="$(basename "$line")"
        # Skip timestamp session dirs and session subdirs
        if is_timestamp_session_dir "$name"; then
            continue
        fi
        if [[ "$line" == *"/.ai/sessions/"* ]] || [[ "$line" == *"/.ai-session/sessions/"* ]]; then
            continue
        fi
        entries+=("$line")
    done < "$RECENT_FILE"

    # Rewrite cleaned file
    if [[ ${#entries[@]} -gt 0 ]]; then
        printf '%s\n' "${entries[@]}" > "${RECENT_FILE}.tmp" && mv "${RECENT_FILE}.tmp" "$RECENT_FILE"
    fi

    if [[ ${#entries[@]} -eq 0 ]]; then
        echo ""
        echo "暂无最近项目。"
        return 1
    fi

    # Show at most 10
    local max_show=10
    if [[ ${#entries[@]} -lt 10 ]]; then
        max_show=${#entries[@]}
    fi

    while true; do
        echo ""
        echo "最近项目:"
        echo ""
        local i
        for (( i=0; i<max_show; i++ )); do
            local name
            name="$(basename "${entries[$i]}")"
            local indicators
            indicators="$(project_indicators "${entries[$i]}")"
            printf "  %-2d %s  %s\n" "$((i+1))" "$name" "$indicators"
            printf "      %s\n" "${entries[$i]}"
            echo ""
        done
        echo "   b  返回主菜单"
        echo "   q  退出"
        echo ""
        read -r -p "请选择编号: " NUM

        if [[ "$NUM" == "b" || "$NUM" == "B" ]]; then
            return 1
        fi
        if [[ "$NUM" == "q" || "$NUM" == "Q" ]]; then
            echo "已取消。"
            exit 0
        fi
        if [[ "$NUM" =~ ^[0-9]+$ ]] && (( NUM >= 1 && NUM <= max_show )); then
            PROJECT_DIR="${entries[$((NUM-1))]}"
            CC_PROJECT_MODE="existing"
            return 0
        fi
        echo "无效选择。" >&2
    done
}

# ─── Helper: create new project in ~/Projects ─────────────────────────────
create_new_project() {
    local projects_dir="$HOME/Projects"

    while true; do
        echo ""
        read -r -p "请输入项目名称: " PROJ_NAME

        # Trim leading/trailing whitespace
        PROJ_NAME="$(echo "$PROJ_NAME" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"

        if [[ -z "$PROJ_NAME" ]]; then
            echo "错误: 项目名称不能为空。" >&2
            continue
        fi

        # Reject path traversal: / .. or ~ prefix
        if [[ "$PROJ_NAME" == *"/"* ]] || [[ "$PROJ_NAME" == *".."* ]] || [[ "$PROJ_NAME" == "~"* ]]; then
            echo "错误: 项目名称不能包含路径分隔符或特殊字符。" >&2
            continue
        fi

        local target_dir="${projects_dir}/${PROJ_NAME}"

        echo ""
        echo "将创建："
        echo "  ${target_dir}"
        echo ""
        echo "  1  创建并打开"
        echo "  2  重新输入"
        echo "  b  返回主菜单"
        echo "  q  退出"
        echo ""
        read -r -p "请选择 (1/2/b/q): " CREATE_CONFIRM

        case "$CREATE_CONFIRM" in
            1) ;;
            2) continue ;;
            b|B) return 1 ;;
            q|Q) echo "已取消。"; exit 0 ;;
            *) echo "无效选择。" >&2; continue ;;
        esac

        if [[ -d "$target_dir" ]]; then
            echo ""
            echo "项目已存在："
            echo "  $target_dir"
            echo ""
            echo "  1  直接打开已有项目"
            echo "  2  重新输入名称"
            echo "  b  返回主菜单"
            echo "  q  退出"
            echo ""
            read -r -p "请选择 (1/2/b/q): " EXIST_CHOICE

            case "$EXIST_CHOICE" in
                1)
                    PROJECT_DIR="$target_dir"
                    CC_PROJECT_MODE="existing"
                    echo ""
                    echo "打开现有项目: $PROJECT_DIR"
                    return 0
                    ;;
                2) continue ;;
                b|B) return 1 ;;
                q|Q) echo "已取消。"; exit 0 ;;
                *) echo "无效选择。" >&2; continue ;;
            esac
        fi

        # Create directory
        if ! mkdir -p "$target_dir"; then
            echo "错误: 无法创建目录: $target_dir" >&2
            return 1
        fi

        # Initialize git
        if ! git -C "$target_dir" init &>/dev/null; then
            echo "警告: git init 失败，但目录已创建。" >&2
        fi

        echo ""
        echo "项目创建成功："
        echo "  $target_dir"

        PROJECT_DIR="$target_dir"
        CC_PROJECT_MODE="new"
        return 0
    done
}

# ─── Determine project ─────────────────────────────────────────────────────
determine_project() {
    # Priority 0: _CC_HERE_MODE — use current directory directly (no menu)
    if [[ "${_CC_HERE_MODE:-}" == "1" ]]; then
        PROJECT_DIR="$PWD"
        CC_PROJECT_MODE="current"
        echo ""
        echo "cc-here 模式: 使用当前目录 $PROJECT_DIR"
        return 0
    fi

    # Priority 0b: _CC_PRESET_PROJECT — use preset project directory
    if [[ -n "${_CC_PRESET_PROJECT:-}" ]] && [[ -d "${_CC_PRESET_PROJECT}" ]]; then
        PROJECT_DIR="${_CC_PRESET_PROJECT}"
        CC_PROJECT_MODE="existing"
        echo ""
        echo "使用预设项目: $PROJECT_DIR"
        return 0
    fi

    # Priority 1: current directory is inside a git repo
    if git rev-parse --show-toplevel &>/dev/null 2>&1; then
        PROJECT_DIR="$(git rev-parse --show-toplevel)"
        echo ""
        echo "检测到 Git 项目: $PROJECT_DIR"
        CC_PROJECT_MODE="current"
        return 0
    fi

    # Priority 2: show project selection menu
    while true; do
        echo ""
        echo "╔══════════════════════════════════════════╗"
        echo "║  Claude / DeepSeek / Codex 项目启动器    ║"
        echo "╠══════════════════════════════════════════╣"
        echo "║                                          ║"
        echo "║  当前目录不是 Git 仓库。请选择项目:      ║"
        echo "║                                          ║"
        echo "║  1  当前目录"
        echo "║  2  最近项目"
        echo "║  3  从 ~/Projects 中选择项目"
        echo "║  4  在 ~/Projects 中新建项目"
        echo "║  5  手动输入项目路径"
        echo "║  q  退出"
        echo "║                                          ║"
        echo "╚══════════════════════════════════════════╝"
        echo ""
        read -r -p "请选择 (1/2/3/4/5/q): " PROJ_CHOICE

        case "$PROJ_CHOICE" in
            1)
                PROJECT_DIR="$PWD"
                CC_PROJECT_MODE="current"
                return 0
                ;;
            2)
                if recent_projects_menu; then
                    return 0
                fi
                ;;
            3)
                if browse_projects_dir; then
                    return 0
                fi
                ;;
            4)
                if create_new_project; then
                    return 0
                fi
                ;;
            5)
                if manual_project_input; then
                    return 0
                fi
                ;;
            q|Q)
                echo "已取消。"
                exit 0
                ;;
            *)
                echo "无效选择，请重试。" >&2
                ;;
        esac
    done
}

# ─── Main flow ─────────────────────────────────────────────────────────────

# Step 0: Determine project
determine_project

show_remote_session_banner

# Record to recent projects (skip here-mode shortcut)
if [[ "${_CC_HERE_MODE:-}" != "1" ]]; then
    add_to_recent "$PROJECT_DIR"
fi

# Safety: PROJECT_DIR must be set and exist at this point
if [[ -z "${PROJECT_DIR:-}" ]] || [[ ! -d "$PROJECT_DIR" ]]; then
    echo "内部错误: 项目目录未正确设置。" >&2
    exit 1
fi

# Handle non-git projects (only for existing/manual modes, not new)
if [[ "$CC_PROJECT_MODE" != "new" ]] && ! has_git "$PROJECT_DIR"; then
    if ! handle_non_git_project "$PROJECT_DIR"; then
        # User chose to go back — restart menu
        exec "$0"
    fi
fi

# ─── Step 1: Choose provider ────────────────────────────────────────────
echo ""
echo "╔══════════════════════════════════════════╗"
echo "║  Claude / DeepSeek / Codex 项目启动器    ║"
echo "╠══════════════════════════════════════════╣"
echo "║                                          ║"
echo "║  项目: ${PROJECT_DIR}"
echo "║                                          ║"
echo "║  选择工具:                               ║"
echo "║  c   Claude（Anthropic 原生）            ║"
echo "║  d   DeepSeek V4 Pro                     ║"
echo "║  o   OpenAI Codex（GPT-5.6 Sol）         ║"
echo "║  q   退出                                ║"
echo "║                                          ║"
echo "╚══════════════════════════════════════════╝"
echo ""
read -r -p "请选择 (c/d/o/q): " PROVIDER_CHOICE

case "$PROVIDER_CHOICE" in
    c|C)
        PROVIDER="claude"
        PROVIDER_NAME="Claude (Anthropic 原生)"
        CONFIG_DIR="$HOME/.claude-native"
        ;;
    d|D)
        PROVIDER="deepseek"
        PROVIDER_NAME="DeepSeek V4 Pro"
        CONFIG_DIR="$HOME/.claude-deepseek"
        ;;
    o|O)
        PROVIDER="codex"
        PROVIDER_NAME="OpenAI Codex (GPT-5.6 Sol)"
        ;;
    q|Q)
        echo "已取消。"
        exit 0
        ;;
    *)
        echo "无效选择，已取消。"
        exit 1
        ;;
esac

# ─── Step 2: Choose permission mode ─────────────────────────────────────
if [[ "$PROVIDER" == "codex" ]]; then
    # ─── Codex permission menu ──────────────────────────────────────────
    echo ""
    echo "╔══════════════════════════════════════════╗"
    echo "║  OpenAI Codex — GPT-5.6 Sol             ║"
    echo "╠══════════════════════════════════════════╣"
    echo "║                                          ║"
    echo "║  m   手动确认                            ║"
    echo "║      workspace-write + on-request        ║"
    echo "║                                          ║"
    echo "║  p   只读规划                            ║"
    echo "║      read-only + never                   ║"
    echo "║                                          ║"
    echo "║  a   项目内自动执行                      ║"
    echo "║      workspace-write + never             ║"
    echo "║                                          ║"
    echo "║  b   完全访问 ⚠                         ║"
    echo "║      danger-full-access + never          ║"
    echo "║                                          ║"
    echo "║  q   返回                                ║"
    echo "║                                          ║"
    echo "╚══════════════════════════════════════════╝"
    echo ""
    read -r -p "请选择 (m/p/a/b/q): " CODEX_MODE_CHOICE

    case "$CODEX_MODE_CHOICE" in
        m|M)
            CODEX_PROFILE="gpt56-sol-manual"
            CODEX_MODE_NAME="手动确认 (workspace-write + on-request)"
            ;;
        p|P)
            CODEX_PROFILE="gpt56-sol-readonly"
            CODEX_MODE_NAME="只读规划 (read-only + never)"
            ;;
        a|A)
            CODEX_PROFILE="gpt56-sol-auto"
            CODEX_MODE_NAME="项目内自动执行 (workspace-write + never)"
            ;;
        b|B)
            CODEX_PROFILE="gpt56-sol-full"
            CODEX_MODE_NAME="完全访问 ⚠️ (danger-full-access + never)"
            ;;
        q|Q)
            # Restart to tool selection
            export _CC_PRESET_PROJECT="$PROJECT_DIR"
            export _CC_HERE_MODE="${_CC_HERE_MODE:-}"
            exec "$0"
            ;;
        *)
            echo "无效选择，已取消。"
            exit 1
            ;;
    esac

    # ─── Warning for full access ────────────────────────────────────────
    if [[ "$CODEX_PROFILE" == "gpt56-sol-full" ]]; then
        echo ""
        echo "╔══════════════════════════════════════════════════════════╗"
        echo "║  ⚠️  警告: danger-full-access                           ║"
        echo "╠══════════════════════════════════════════════════════════╣"
        echo "║  danger-full-access 将跳过所有沙箱限制。               ║"
        echo "║  Codex 可以修改系统中当前用户能访问的任何文件。        ║"
        echo "║  请确认你信任即将进行的操作。                           ║"
        echo "╚══════════════════════════════════════════════════════════╝"
        echo ""
        if ! confirm_remote_high_risk "Codex danger-full-access"; then
            exit 1
        fi
    fi

    # ─── Confirm launch ─────────────────────────────────────────────────
    echo "╔══════════════════════════════════════════╗"
    echo "║  确认启动                                ║"
    echo "╠══════════════════════════════════════════╣"
    echo "║  项目: ${PROJECT_DIR}"
    echo "║  工具: ${PROVIDER_NAME}"
    echo "║  权限: ${CODEX_MODE_NAME}"
    echo "╚══════════════════════════════════════════╝"
    echo ""
    CONFIRM=""
    if ! read -r -p "请输入 'yes' 确认启动: " CONFIRM; then
        echo "输入已关闭，已取消。"
        exit 1
    fi
    if [[ "$CONFIRM" != "yes" ]]; then
        echo "已取消。"
        exit 1
    fi

    # ─── Codex preflight check ──────────────────────────────────────────
    if ! codex_preflight_check "$CODEX_PROFILE"; then
        echo ""
        echo "╔══════════════════════════════════════════════════════════╗"
        echo "║  Codex 启动前检查失败                                   ║"
        echo "╠══════════════════════════════════════════════════════════╣"
        echo "║                                                        ║"
        echo "║  请检查:                                               ║"
        echo "║  1. Codex CLI 是否安装且 >= 0.144.0                    ║"
        echo "║  2. 是否已运行 codex login 完成认证                    ║"
        echo "║  3. 项目目录是否存在                                   ║"
        echo "║                                                        ║"
        echo "║  1  返回工具菜单                                       ║"
        echo "║  q  退出                                               ║"
        echo "║                                                        ║"
        echo "╚══════════════════════════════════════════════════════════╝"
        echo ""
        read -r -p "请选择 (1/q): " CODEX_ERR_CHOICE
        case "$CODEX_ERR_CHOICE" in
            1)
                export _CC_PRESET_PROJECT="$PROJECT_DIR"
                export _CC_HERE_MODE="${_CC_HERE_MODE:-}"
                exec "$0"
                ;;
            *)
                echo "已取消。"
                exit 1
                ;;
        esac
    fi

    # ─── Launch Codex ───────────────────────────────────────────────────
    export CC_ACTIVE_PROJECT="$PROJECT_DIR"
    export CC_PROJECT_MODE

    cd -- "$PROJECT_DIR" || {
        echo "错误: 无法切换到项目目录: $PROJECT_DIR" >&2
        exit 1
    }

    if [[ "$PWD" != "$PROJECT_DIR" ]]; then
        echo "错误: 工作目录切换失败。期望: $PROJECT_DIR, 实际: $PWD" >&2
        exit 1
    fi

    CODEX_BIN="$(type -P codex || true)"
if [[ -z "$CODEX_BIN" || ! -x "$CODEX_BIN" ]]; then
    echo "错误：找不到可执行的 OpenAI Codex CLI。"
    exit 1
fi
exec "$CODEX_BIN" --profile "$CODEX_PROFILE"

else
    # ─── Claude / DeepSeek permission menu ──────────────────────────────

echo ""
echo "╔══════════════════════════════════════════╗"
echo "║  Claude / DeepSeek 全局项目启动器        ║"
echo "╠══════════════════════════════════════════╣"
echo "║                                          ║"
echo "║  项目: ${PROJECT_DIR}"
echo "║  模型: ${PROVIDER_NAME}"
echo "║                                          ║"
echo "║  选择初始权限:                           ║"
echo "║  m   Manual                              ║"
echo "║  e   acceptEdits                         ║"
echo "║  p   plan (只分析，不修改)               ║"
echo "║  a   auto (自动执行)                     ║"
echo "║  b   bypassPermissions ⚠️                ║"
echo "║  q   返回                                ║"
echo "║                                          ║"
echo "╚══════════════════════════════════════════╝"
echo ""
read -r -p "请选择 (m/e/p/a/b/q): " MODE_CHOICE

case "$MODE_CHOICE" in
    m|M)
        PERM_MODE="default"
        PERM_MODE_NAME="Manual"
        BYPASS_START=false
        ;;
    e|E)
        PERM_MODE="acceptEdits"
        PERM_MODE_NAME="acceptEdits"
        BYPASS_START=false
        ;;
    p|P)
        PERM_MODE="plan"
        PERM_MODE_NAME="plan (只分析)"
        BYPASS_START=false
        ;;
    a|A)
        PERM_MODE="auto"
        PERM_MODE_NAME="auto"
        BYPASS_START=false
        ;;
    b|B)
        PERM_MODE="bypassPermissions"
        PERM_MODE_NAME="bypassPermissions"
        BYPASS_START=true
        ;;
    q|Q)
        # Restart to provider selection — re-exec with project pre-selected
        export _CC_PRESET_PROJECT="$PROJECT_DIR"
        export _CC_HERE_MODE="${_CC_HERE_MODE:-}"
        exec "$0"
        ;;
    *)
        echo "无效选择，已取消。"
        exit 1
        ;;
esac

# ─── Warning for bypassPermissions ──────────────────────────────────────
if [[ "$BYPASS_START" == true ]]; then
    echo ""
    echo "╔══════════════════════════════════════════════════════════╗"
    echo "║  ⚠️  警告: bypassPermissions                           ║"
    echo "╠══════════════════════════════════════════════════════════╣"
    echo "║  bypassPermissions 将跳过大多数权限确认。              ║"
    echo "║  它可以修改项目、Git 配置及其他当前用户                ║"
    echo "║  能够访问的文件。                                       ║"
    echo "║                                                        ║"
    echo "║  媒体目录和沙箱限制仍然保留。                           ║"
    echo "╚══════════════════════════════════════════════════════════╝"
    echo ""
    if ! confirm_remote_high_risk "Claude/DeepSeek bypassPermissions"; then
        exit 1
    fi
fi

# ─── Confirm launch ─────────────────────────────────────────────────────
echo "╔══════════════════════════════════════════╗"
echo "║  确认启动                                ║"
echo "╠══════════════════════════════════════════╣"
echo "║  项目: ${PROJECT_DIR}"
echo "║  模型: ${PROVIDER_NAME}"
echo "║  权限: ${PERM_MODE_NAME}"
if [[ "$BYPASS_START" != true ]]; then
    echo "║  Shift+Tab 可切换权限模式                ║"
fi
echo "╚══════════════════════════════════════════╝"
echo ""
CONFIRM=""
if ! read -r -p "请输入 'yes' 确认启动: " CONFIRM; then
    echo "输入已关闭，已取消。"
    exit 1
fi
if [[ "$CONFIRM" != "yes" ]]; then
    echo "已取消。"
    exit 1
fi

# ─── Prepare environment ────────────────────────────────────────────────
export CLAUDE_CONFIG_DIR="$CONFIG_DIR"

if [[ "$PROVIDER" == "claude" ]]; then
    # Clear any lingering DeepSeek/alternative provider env vars
    unset ANTHROPIC_BASE_URL
    unset ANTHROPIC_AUTH_TOKEN
    unset ANTHROPIC_API_KEY
    unset ANTHROPIC_MODEL
    unset ANTHROPIC_DEFAULT_OPUS_MODEL
    unset ANTHROPIC_DEFAULT_SONNET_MODEL
    unset ANTHROPIC_DEFAULT_HAIKU_MODEL
    unset CLAUDE_CODE_SUBAGENT_MODEL
    unset CLAUDE_CODE_EFFORT_LEVEL
fi

# ─── Build launch command ───────────────────────────────────────────────
if [[ "$BYPASS_START" == true ]]; then
    CMD_ARGS=(--permission-mode bypassPermissions)
else
    CMD_ARGS=(--allow-dangerously-skip-permissions --permission-mode "$PERM_MODE")
fi

# ─── CRITICAL FIX: Set CC_ACTIVE_PROJECT as single source of truth ──────
# This is the ONE variable that AI Project Manager and all hooks MUST respect.
# When set, they MUST use this directory and MUST NOT create a new one.
export CC_ACTIVE_PROJECT="$PROJECT_DIR"
export CC_PROJECT_MODE

# ─── AI Project Manager integration ─────────────────────────────────────
# ALWAYS use launch-here with the determined project directory.
# NEVER use launch-new — it ignores user's project choice and creates
# a timestamp directory in ~/Projects.
exec aiproj launch-here --tool claude \
    --dir "$PROJECT_DIR" \
    --cli-path "$(type -P claude 2>/dev/null || echo claude)" \
    --provider "${PROVIDER}" \
    --permission-mode "${PERM_MODE}" \
    -- "${CMD_ARGS[@]}"
fi
