{
  "name": "confera-media-inspector",
  "purpose": "Inspect media metadata safely",
  "version": "1.0.0",
  "model": "configured-fast",
  "effort": "low",
  "context": "fork",
  "agent": "confera-fast-analyzer",
  "capability": "MEDIA_INSPECTION",
