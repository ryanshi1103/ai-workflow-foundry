{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ryanshi1103/ai-workflow-foundry/schemas/workflow-contract.schema.json",
  "title": "FlowFoundry Portable Workflow Contract v1",
  "description": "A versioned, portable workflow definition that declares stages, artifacts, review points, and execution-approval gates. A host can validate a contract without importing the component's application code.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "display_name",
    "version",
    "description",
    "stages",
    "approval_gates",
    "safety"
  ],
  "properties": {
    "schema_version": { "const": 1 },

    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Unique kebab-case workflow identifier."
    },

    "display_name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable workflow name."
    },

    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[a-zA-Z0-9]+(?:\\.[a-zA-Z0-9]+)*)?(?:\\+[a-zA-Z0-9]+(?:\\.[a-zA-Z0-9]+)*)?$",
      "description": "Semantic version (SemVer 2.0) of the workflow definition."
    },

    "description": {
      "type": "string",
      "minLength": 1,
      "description": "What this workflow accomplishes from the user's perspective."
    },

    "stages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Ordered stages that compose the workflow.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description", "produces"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Stage identifier, unique within the workflow."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Short human-readable stage label."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "What this stage does."
          },
          "required_inputs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "description", "content_type"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "description": { "type": "string", "minLength": 1 },
                "content_type": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Expected MIME type or file extension of the input."
                },
                "constraints": {
                  "type": "object",
                  "description": "Optional schema or format constraints on the input.",
                  "properties": {
                    "schema_ref": { "type": "string" },
                    "max_size_bytes": { "type": "integer", "minimum": 0 },
                    "allowed_extensions": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": { "type": "string" }
                    }
                  }
                }
              }
            }
          },
          "produces": {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifacts"],
            "properties": {
              "artifacts": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "description", "content_type"],
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "description": { "type": "string", "minLength": 1 },
                    "content_type": {
                      "type": "string",
                      "minLength": 1,
                      "description": "MIME type or file extension of the output artifact."
                    },
                    "content_addressed": {
                      "type": "boolean",
                      "default": false,
                      "description": "Whether the artifact is content-addressed (e.g., SHA-256)."
                    },
                    "schema_ref": {
                      "type": "string",
                      "description": "Optional reference to a JSON Schema or format specification."
                    }
                  }
                }
              },
              "review_required": {
                "type": "boolean",
                "default": false,
                "description": "Whether human review is required after this stage before the next one can run."
              },
              "review_instructions": {
                "type": "string",
                "description": "Guidance for the human reviewer about what to check."
              }
            }
          },
          "adapter": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "entry_point"],
            "description": "How this stage is executed.",
            "properties": {
              "type": {
                "enum": [
                  "claude-skill",
                  "codex-skill",
                  "deterministic-command",
                  "python-module",
                  "manual"
                ],
                "description": "The adapter type that executes this stage."
              },
              "entry_point": {
                "type": "string",
                "minLength": 1,
                "description": "Skill path, shell command, Python dotted path, or manual instruction reference."
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 86400,
                "description": "Maximum runtime before the stage is considered failed."
              },
              "retry": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "max_attempts": { "type": "integer", "minimum": 1, "maximum": 10 },
                  "backoff": {
                    "enum": ["fixed", "exponential"],
                    "description": "Backoff strategy between retries."
                  }
                }
              }
            }
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string" },
            "description": "Stage IDs that must complete before this stage can start (for DAG workflows; omit for linear pipelines)."
          }
        }
      }
    },

    "approval_gates": {
      "type": "array",
      "uniqueItems": true,
      "description": "Explicit execution-approval points. An approval gate is a separate, auditable decision — not the same as review_required on a stage.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "after_stage", "description"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Short label shown at the approval prompt."
          },
          "after_stage": {
            "type": "string",
            "minLength": 1,
            "description": "Stage ID after which this approval is required."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "What the approver is being asked to confirm."
          },
          "scope": {
            "type": "string",
            "enum": ["destructive", "export", "network", "cost", "all"],
            "default": "all",
            "description": "What kind of action the approval covers."
          },
          "auto_approve_policy": {
            "type": "string",
            "enum": ["never", "dry-run", "trusted-inputs", "always"],
            "default": "never",
            "description": "When auto-approval is acceptable. 'never' is the safe default."
          }
        }
      }
    },

    "capabilities_required": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "description": "Capability IDs from the component catalog that this workflow requires."
      },
      "description": "Capabilities that must be available in the host's capability registry."
    },

    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_first", "network_policy", "side_effects"],
      "properties": {
        "local_first": {
          "type": "boolean",
          "description": "Whether this workflow can run entirely locally."
        },
        "network_policy": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable description of when and why network access is needed."
        },
        "side_effects": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stage_id", "description", "kind"],
            "properties": {
              "stage_id": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "kind": {
                "enum": [
                  "file_write",
                  "file_delete",
                  "network_call",
                  "api_call",
                  "system_command",
                  "credential_access",
                  "database_write",
                  "external_service"
                ]
              },
              "reversible": {
                "type": "boolean",
                "description": "Whether this side effect can be undone."
              }
            }
          }
        }
      }
    },

    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "description": "Idempotency guarantees for the workflow as a whole.",
      "properties": {
        "key_source": {
          "type": "string",
          "enum": ["content-hash", "input-hash", "explicit-version", "none"],
          "default": "none",
          "description": "How idempotency keys are derived."
        },
        "description": {
          "type": "string",
          "description": "Human-readable explanation of idempotency behavior."
        }
      }
    }
  }
}
